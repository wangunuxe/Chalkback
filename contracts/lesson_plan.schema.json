{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lesson_plan",
  "description": "教案：本节课计划讲的知识点。C（老师填）→ B。~/.chalkback/lesson_plans/{class_id}/{date}.json。不离开老师电脑。§5",
  "type": "object",
  "additionalProperties": false,
  "required": ["class_id", "date", "syllabus_id", "kp_ids"],
  "properties": {
    "class_id": {"type": "string", "minLength": 1},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "syllabus_id": {"type": "string", "minLength": 1},
    "kp_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
