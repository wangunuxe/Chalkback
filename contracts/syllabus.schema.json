{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "syllabus",
  "description": "考纲知识点清单。D 产生（Hub），A/B/C 使用；本机缓存 ~/.chalkback/cache/syllabus.json。§5",
  "type": "object",
  "additionalProperties": false,
  "required": ["syllabus_id", "version", "status", "subject", "level", "knowledge_points"],
  "properties": {
    "syllabus_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "approved"]},
    "subject": {"type": "string", "minLength": 1},
    "level": {"type": "string", "minLength": 1},
    "knowledge_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kp_id", "title", "keywords"],
        "properties": {
          "kp_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "keywords": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
