{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coverage_share",
  "description": "The only coverage format allowed to be uploaded to the Hub, generated by C from coverage. additionalProperties=false is the privacy boundary: no raw text, segment_ids, teacher_id or any screenpipe id may appear. §5",
  "type": "object",
  "additionalProperties": false,
  "required": ["lesson_id", "class_id", "date", "syllabus_id", "syllabus_version", "points"],
  "properties": {
    "lesson_id": {"type": "string", "pattern": "^L-[A-Za-z0-9]+-\\d{8}-\\d{4}$"},
    "class_id": {"type": "string", "minLength": 1},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "syllabus_id": {"type": "string", "minLength": 1},
    "syllabus_version": {"type": "integer", "minimum": 1},
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kp_id", "covered", "minutes"],
        "properties": {
          "kp_id": {"type": "string", "minLength": 1},
          "covered": {"type": "boolean"},
          "minutes": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
