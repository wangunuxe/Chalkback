# Copy to .env (never committed, see .gitignore) and fill in:  cp .env.example .env
# Read by docker compose (make up / make school) and by make hub. No spaces or quotes around values.

# Hub syllabus import with AI (docs/ADMIN.md section 3). Set ONE of the two keys; both empty = import disabled.
# Claude: key from console.anthropic.com (starts with sk-ant-); a Claude Pro subscription cannot be used here.
ANTHROPIC_API_KEY=
# Gemini: key from aistudio.google.com (starts with AIza)
GEMINI_API_KEY=gemini-3.1-flash-lite

# Optional. Model id as the API names it (not the display name), e.g. claude-opus-5-5 or gemini-3.1-flash-lite.
# Empty = claude-opus-5-5 for Claude, gemini-flash-latest for Gemini.
HUB_AI_MODEL=
# Optional: anthropic or gemini, when both keys are set (default: anthropic)
HUB_AI_PROVIDER=
